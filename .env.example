# ===== Shared =====
NODE_ENV=development

# ===== apps/api =====
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Mongo (matches docker-compose service)
MONGO_URI=mongodb://localhost:27017/anaaj_mandi

# Redis (matches docker-compose — host port is 6380 to avoid clashing with any
# other local redis instance; the container still listens on 6379 internally).
REDIS_URL=redis://localhost:6380

# JWT for httpOnly cookie issued by Fastify
JWT_SECRET=replace-me-with-a-long-random-string
JWT_COOKIE_NAME=am_session
JWT_TTL_DAYS=30

# Twilio Verify — stubbed in dev (OTP 123456 always accepted)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_DEV_BYPASS=true

# Cloudinary — used for signed direct uploads from the browser
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=anaaj-mandi/lots

# ===== apps/web =====
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
